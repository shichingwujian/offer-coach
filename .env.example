# 用法：复制本文件为 .env 并填入真实值。
# .env 已在 .gitignore 里，永远不进仓库；本模板（.env.example）是进 git 的，
# 所以这里只放占位符——永远别把真 key 写进这个文件！

# 必填：你的 API key（DeepSeek 开放平台申请，形如 sk-xxxxxxxx）
OPENAI_API_KEY=sk-在这里填你的key

# 可选：接口地址（用 DeepSeek 就填 https://api.deepseek.com；官方 OpenAI 可留空）
OPENAI_BASE_URL=https://api.deepseek.com

# 可选：模型名（默认 deepseek-chat）
OPENAI_MODEL=deepseek-chat
